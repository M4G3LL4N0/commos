# --- CommOS environment ---
# Copy to .env.local and fill in. Everything has a safe default for local dev.

# Where CommOS stores its SQLite database and runtime files (gitignored).
# COMMOS_DATA_DIR=./data

# Next.js app. UI runs in the browser.
# PORT=3000

# --- Operator dashboard authentication ---
# Password for the CommOS operator dashboard. If unset, a random password is
# generated on first boot and printed to the console (stored hashed in the DB).
# COMMOS_OPERATOR_PASSWORD=

# --- Secret encryption ---
# Master key used to encrypt connector credentials at rest (AES-256-GCM).
# If unset, CommOS generates a key on first boot and stores it in
# $COMMOS_DATA_DIR/secrets.key (gitignored). Only the ciphertext touches disk
# in the database; secrets are never returned by the API.
# COMMOS_MASTER_KEY=

# --- Email (primary outbound provider: Resend) ---
# RESEND_API_KEY=rk_live_...
# COMMOS_EMAIL_FROM=commos@example.com
# COMMOS_EMAIL_DOMAIN=example.com

# --- SMTP email connector (optional secondary) ---
# COMMOS_SMTP_HOST=
# COMMOS_SMTP_PORT=587
# COMMOS_SMTP_SECURE=false
# COMMOS_SMTP_USER=
# COMMOS_SMTP_PASS=

# --- BlueBubbles / iMessage ---
# COMMOS_BLUEBUBBLES_URL=http://localhost:1234
# COMMOS_BLUEBUBBLES_PASSWORD=

# --- Twilio (SMS/MMS/Voice) ---
# COMMOS_TWILIO_ACCOUNT_SID=
# COMMOS_TWILIO_AUTH_TOKEN=
# COMMOS_TWILIO_DEFAULT_FROM=

# --- Public base URL of this CommOS instance (for outbound webhook signing) ---
# COMMOS_PUBLIC_URL=http://localhost:3000

# --- Secrets abuse guard ---
# SECURITY: never set this to "true" in production.
# COMMOS_ALLOW_SIMULATED_SEND=true